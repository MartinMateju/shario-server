# Optional overrides for `npm run test:e2e:server`.
#
# Must match the value used by the Playwright process. The same safe local
# default is used by both projects when this variable is omitted.
E2E_TEST_KEY=shario-e2e-local-key

# By default the command starts a local MongoMemoryReplSet and uses the
# dedicated `shario-e2e` database. To use an existing Mongo replica set, copy
# this file to `.env.e2e` and provide a database name containing a standalone
# `e2e` or `test` segment. The reset endpoint refuses every other database.
E2E_MONGO_URI=mongodb://127.0.0.1:27017/shario-e2e?replicaSet=rs0
# Required only when E2E_MONGO_URI is set. The harness refuses to connect to
# an external database without this exact destructive-reset acknowledgement.
E2E_ALLOW_DATABASE_RESET=true

# mongodb-memory-server may use this cache when its binary is not already
# installed. This is optional.
MONGOMS_DOWNLOAD_DIR=
