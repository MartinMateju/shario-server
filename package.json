{
  "name": "shario-server",
  "version": "1.0.0",
  "description": "Shario API for shared spaces, bookings, memberships and operations.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-voucher-fonts.mjs",
    "prebuild": "node scripts/install-voucher-fonts.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --clear-screen=false src/server.ts",
    "start": "node dist/server.js",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "typecheck:production": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit -p tsconfig.build.json",
    "redis:start": "docker compose up -d redis",
    "redis:stop": "docker compose stop redis",
    "redis:ping": "docker compose exec redis redis-cli ping",
    "redis:logs": "docker compose logs -f redis",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e:server": "node --import tsx tests/e2e/support/e2e-server.ts",
    "stripe:setup-billing-portal": "tsx src/modules/tenant-subscription/scripts/configure-tenant-billing-portal.ts",
    "stripe:tenant-catalog": "tsx src/modules/tenant-subscription/scripts/sync-tenant-subscription-catalog.ts",
    "stripe:tenant-catalog:verify": "tsx src/modules/tenant-subscription/scripts/sync-tenant-subscription-catalog.ts --verify",
    "migration:currency-foundation": "tsx src/modules/tenants/scripts/migrate-currency-foundation.ts",
    "migration:tenant-access": "tsx src/modules/tenant-access/scripts/backfill-tenant-memberships.ts",
    "migration:invoices": "tsx src/modules/invoice/scripts/migrate-invoice-foundation.ts",
    "migration:memberships-v1": "tsx src/modules/membership/scripts/migrate-membership-v1.ts",
    "migration:product-kinds-v2": "tsx src/modules/product/scripts/migrate-product-kinds-v2.ts",
    "migration:product-class-categories": "tsx src/modules/product/scripts/backfill-product-class-categories.ts",
    "migration:product-locations": "tsx src/modules/product/scripts/migrate-product-locations.ts",
    "indexes:open-studio:plan": "tsx src/modules/product/scripts/sync-open-studio-location-index.ts",
    "indexes:open-studio": "tsx src/modules/product/scripts/sync-open-studio-location-index.ts --apply",
    "migration:inventory-stock-levels": "tsx src/modules/inventory/scripts/migrate-inventory-stock-levels.ts",
    "migration:access-code-inventory": "tsx src/modules/access-codes/scripts/migrate-access-code-inventory.ts",
    "migration:public-site-editor": "tsx src/modules/tenants/scripts/migrate-public-site-editor.ts",
    "migration:workspace-configuration": "tsx src/modules/tenants/scripts/migrate-workspace-configuration.ts",
    "migration:workspace-intent": "tsx src/modules/tenants/scripts/migrate-workspace-intent.ts",
    "worker:communication-emails": "node dist/workers/communication-email.worker.js",
    "worker:communication-emails:dev": "tsx src/workers/communication-email.worker.ts",
    "worker:communication-scheduler": "node dist/workers/communication-automation-scheduler.worker.js",
    "worker:communication-scheduler:dev": "tsx src/workers/communication-automation-scheduler.worker.ts",
    "worker:data-imports": "node dist/workers/data-import.worker.js",
    "worker:data-imports:dev": "tsx src/workers/data-import.worker.ts",
    "migration:importable-customers": "tsx src/modules/user/scripts/migrate-importable-customers.ts",
    "migration:user-member-numbers": "tsx src/modules/user/scripts/migrate-user-member-numbers.ts",
    "migration:commerce-import-indexes": "tsx src/modules/data-import/scripts/migrate-commerce-import-indexes.ts",
    "migration:coupon-value-snapshots": "tsx src/modules/coupon/scripts/migrate-coupon-value-snapshots.ts",
    "migration:communication-email-idempotency": "node dist/modules/communication-email-logs/scripts/migrate-communication-email-log-idempotency.js",
    "migration:communication-email-idempotency:dev": "tsx src/modules/communication-email-logs/scripts/migrate-communication-email-log-idempotency.ts",
    "migration:course-waitlist-indexes": "tsx src/modules/waitlist/scripts/sync-waitlist-indexes.ts",
    "indexes:waitlist:plan": "tsx src/modules/waitlist/scripts/sync-waitlist-indexes.ts",
    "indexes:waitlist": "tsx src/modules/waitlist/scripts/sync-waitlist-indexes.ts --apply",
    "ai:feedback-regressions": "tsx src/modules/ai/scripts/export-feedback-regressions.ts",
    "test:critical": "vitest run --config vitest.critical.config.ts",
    "indexes:vouchers:plan": "tsx src/modules/coupon/scripts/sync-voucher-foundation-indexes.ts",
    "indexes:vouchers": "tsx src/modules/coupon/scripts/sync-voucher-foundation-indexes.ts --apply",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "setup:local": "node scripts/setup-local.mjs",
    "worker:notifications": "node dist/workers/notification.worker.js",
    "worker:notifications:dev": "tsx src/workers/notification.worker.ts",
    "doctor": "node scripts/check-development.mjs"
  },
  "author": "Martin Mateju",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-mono": "5.2.7",
    "@fontsource/noto-serif": "5.2.8",
    "@fontsource/playfair-display": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.78.0",
    "colors": "^1.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.20",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.0",
    "fs-extra": "^11.2.0",
    "intl-messageformat": "11.2.11",
    "ioredis": "^5.10.1",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^9.7.3",
    "mongoose-sequence": "^5.3.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "stripe": "^14.11.0",
    "uuid": "^14.0.1",
    "validator": "^13.15.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.9",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.1",
    "tsx": "4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
