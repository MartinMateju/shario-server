NODE_ENV=development
PORT=4311
SERVER_URL=http://api.shario.localhost:4311
CLIENT_URL=http://shario.localhost:4310
DEVELOPMENT_ROOT_DOMAIN=shario.localhost
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# Native invoice UI/API and automation are paused for the MVP. Enable together
# with NEXT_PUBLIC_NATIVE_INVOICES_ENABLED=true in the frontend to restore.
# Stripe payments, receipts and subscription billing remain available.
NATIVE_INVOICES_ENABLED=false

# Tenant registration and onboarding use MongoDB transactions. Use Atlas or a
# local replica set; a standalone mongod cannot complete these workflows.
MONGO_URI=mongodb://127.0.0.1:27028/shario?replicaSet=rs0
# Optional comma-separated DNS resolvers. Use only when a local or VPN DNS
# proxy rejects MongoDB Atlas mongodb+srv lookups (for example 8.8.8.8,1.1.1.1).
DNS_SERVERS=
REDIS_URL=redis://127.0.0.1:6381

# Enable only after running both Step 3 commerce-import migrations documented
# in docs/migrations/commerce-imports.md. The API and worker also verify every
# required unique index before accepting or executing these imports.
DATA_IMPORT_COMMERCE_ENABLED=false

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Shared only by this API and the server-side frontend auth proxy. Never use a
# NEXT_PUBLIC_* variable. Required together with AUTH_SESSION_HANDOFF_SECRET
# before enabling paid custom-domain auth. Redis provides cross-instance
# replay claims for every signed proxy request.
AUTH_FIRST_PARTY_PROXY_SECRET=replace-with-a-different-32-byte-random-secret
# Backend-only AES-GCM key material for two-minute OAuth/password session
# handoffs. Keep distinct from JWT and proxy-signing secrets.
AUTH_SESSION_HANDOFF_SECRET=replace-with-another-32-byte-random-secret
# Optional comma-separated parent domains used only to clean up refresh
# cookies issued by older deployments. New refresh cookies stay API-host-only.
# Normal shario.localhost/shario.io deployments do not need to set this.
AUTH_COOKIE_DOMAINS=
# Server-only signing key for 30-minute customer booking intents. Use a
# different random value from ACCESS_TOKEN_SECRET in production.
BOOKING_INTENT_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL=auth@example.com

# End-customer social sign-in (global Shario configuration; never tenant-owned).
# Leave a provider's complete group empty to hide its button.
CUSTOMER_SOCIAL_STATE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://api.shario.localhost:4311/auth/customer/social/google/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
# PKCS#8 .p8 contents. Multiline values may use literal \n characters.
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=https://api.shario.io/auth/customer/social/apple/callback

STRIPE_KEY=sk_test_replace_me
# Explicit guard for tenant subscription catalogue reads and writes. Production
# must use `live` together with an `sk_live_...` key; local/test uses `test`.
STRIPE_TENANT_BILLING_MODE=test
# Legacy platform-account checkout webhook. Keep only while retiring the old
# `/webhook` endpoint; new tenant commerce uses the Connect secret below.
WEBHOOK_SECRET=whsec_legacy_customer_checkout_replace_me
# Enable only during the controlled platform-checkout -> Connect migration.
# It is deliberately disabled by default and must be disabled again after all
# eligible old Sessions and Stripe retries have drained.
LEGACY_PLATFORM_CHECKOUT_WEBHOOK_ENABLED=false
# Dedicated Connect event destination secret. Configure this endpoint for
# connected-account events; never reuse the platform Checkout or Billing
# webhook secret.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_replace_me
STRIPE_BILLING_WEBHOOK_SECRET=whsec_tenant_billing_replace_me
STRIPE_STARTER_MONTHLY_PRICE_ID=price_replace_me
STRIPE_STARTER_YEARLY_PRICE_ID=price_replace_me
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_replace_me
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_replace_me
STRIPE_STUDIO_PLUS_MONTHLY_PRICE_ID=price_replace_me
STRIPE_STUDIO_PLUS_YEARLY_PRICE_ID=price_replace_me
# Stable v1 aliases used by the versioned code-first plan catalogue. You can
# migrate to these gradually; the original six variables above remain valid
# v1 fallbacks. Later versions follow the same *_V2_PRICE_ID pattern, or can be
# resolved by their immutable offer lookup key.
STRIPE_STARTER_MONTHLY_V1_PRICE_ID=
STRIPE_STARTER_YEARLY_V1_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_V1_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_V1_PRICE_ID=
STRIPE_STUDIO_PLUS_MONTHLY_V1_PRICE_ID=
STRIPE_STUDIO_PLUS_YEARLY_V1_PRICE_ID=
# Founding 2026 offer (entitlement v2). Populate these from
# `npm run stripe:tenant-catalog -- --apply` in test mode and from the guarded
# live-mode command documented in the tenant-subscription README.
STRIPE_STARTER_MONTHLY_V2_PRICE_ID=
STRIPE_STARTER_YEARLY_V2_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_V2_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_V2_PRICE_ID=
STRIPE_STUDIO_PLUS_MONTHLY_V2_PRICE_ID=
STRIPE_STUDIO_PLUS_YEARLY_V2_PRICE_ID=
STRIPE_STARTER_MONTHLY_V3_PRICE_ID=
STRIPE_STARTER_YEARLY_V3_PRICE_ID=
STRIPE_PROFESSIONAL_MONTHLY_V3_PRICE_ID=
STRIPE_PROFESSIONAL_YEARLY_V3_PRICE_ID=
STRIPE_STUDIO_PLUS_MONTHLY_V3_PRICE_ID=
STRIPE_STUDIO_PLUS_YEARLY_V3_PRICE_ID=
# Preferred immutable offer aliases. The V2 variables above remain accepted;
# use these offer-scoped names for new production configuration.
STRIPE_FOUNDING_2026_V1_STARTER_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_2026_V1_STARTER_YEARLY_PRICE_ID=
STRIPE_FOUNDING_2026_V1_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_2026_V1_PROFESSIONAL_YEARLY_PRICE_ID=
STRIPE_FOUNDING_2026_V1_STUDIO_PLUS_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_2026_V1_STUDIO_PLUS_YEARLY_PRICE_ID=
# Plan V3 offer. Prices are unchanged, but these are distinct Stripe objects
# and lookup keys so the V2 founding contract stays immutable.
STRIPE_PLANS_V3_2026_V1_STARTER_MONTHLY_PRICE_ID=
STRIPE_PLANS_V3_2026_V1_STARTER_YEARLY_PRICE_ID=
STRIPE_PLANS_V3_2026_V1_PROFESSIONAL_MONTHLY_PRICE_ID=
STRIPE_PLANS_V3_2026_V1_PROFESSIONAL_YEARLY_PRICE_ID=
STRIPE_PLANS_V3_2026_V1_STUDIO_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLANS_V3_2026_V1_STUDIO_PLUS_YEARLY_PRICE_ID=
# Required in live tenant-billing mode after Stripe Tax registrations and
# invoice branding are configured. Live catalogue readiness fails closed when
# this remains false.
STRIPE_AUTOMATIC_TAX_ENABLED=false
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
STRIPE_BILLING_PORTAL_PRIVACY_POLICY_URL=
STRIPE_BILLING_PORTAL_TERMS_OF_SERVICE_URL=

# Legacy platform/system SMTP only. Tenant communications never read these
# values and can never fall back to this sender.
EMAIL_USER=mail@example.com
EMAIL_PASSWORD=replace_me
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_ALLOW_SELF_SIGNED=false
EMAIL_FROM_NAME=shario.io
EMAIL_REPLY_TO=support@example.com
TENANT_BILLING_EMAILS_ENABLED=true
EMAIL_SECRET_KEY=replace-with-at-least-16-random-characters
# Independent, server-only AES-256-GCM key for manual door-code inventory.
# Leave empty until the access-code migration is ready; create/reveal/import
# fail closed while it is missing. Use at least 32 random bytes in production.
ACCESS_CODE_ENCRYPTION_KEY=
# Managed tenant email. The account token may create Postmark Servers but may
# never send mail. The system token is restricted to verification/setup mail.
POSTMARK_ACCOUNT_TOKEN=
POSTMARK_SYSTEM_SERVER_TOKEN=
POSTMARK_SYSTEM_FROM_EMAIL=verify@notify.shario.io
POSTMARK_SYSTEM_FROM_NAME=shario.io
POSTMARK_FROM_DOMAIN=notify.shario.io
# Environment/account namespace. Production and staging must use different
# values when they share a Postmark account (for example shario-prod/shario-stage).
POSTMARK_TENANT_SERVER_PREFIX=shario-development
POSTMARK_MESSAGE_STREAM=outbound
# Every tenant Postmark Server is converged on this status-only webhook.
# Generate a unique username and a password with at least 32 random characters.
POSTMARK_OUTBOUND_WEBHOOK_URL=https://api.example.com/webhooks/postmark/outbound
POSTMARK_OUTBOUND_WEBHOOK_USERNAME=replace-with-random-webhook-user
POSTMARK_OUTBOUND_WEBHOOK_PASSWORD=replace-with-at-least-32-random-characters
POSTMARK_API_URL=https://api.postmarkapp.com
POSTMARK_REQUEST_TIMEOUT_MS=15000
REPLY_TO_VERIFICATION_TTL_SECONDS=900
REPLY_TO_VERIFICATION_RESEND_SECONDS=60
REPLY_TO_VERIFICATION_MAX_ATTEMPTS=5
COMMUNICATION_SCHEDULER_INTERVAL_MS=60000

# Tenant AI platform. Leave OPENAI_API_KEY empty locally to exercise the safe
# deterministic fallbacks. This key is server-only and must never use a
# NEXT_PUBLIC_ prefix or be exposed to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
AI_PENDING_RUN_STALE_MS=300000

# Unified Communications. Local mode records deterministic sent deliveries
# without contacting a provider; production always uses live delivery.
COMMUNICATION_DELIVERY_MODE=local
COMMUNICATION_DELIVERY_BATCH_SIZE=50
# Private voice playback URLs expire quickly and are regenerated only after
# an authenticated, tenant-scoped inbox read (30-900 seconds).
COMMUNICATION_PRIVATE_MEDIA_URL_TTL_SECONDS=300
# Exact HTTPS hosts from which the mailer may fetch outbound attachments.
# R2_PUBLIC_URL is automatically included; use commas for additional hosts.
COMMUNICATION_ATTACHMENT_HOSTS=
COMMUNICATION_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional provider-agnostic AI gateway. Without it the module uses safe,
# deterministic categorization/drafts and never invents voice transcripts.
COMMUNICATION_AI_URL=
COMMUNICATION_AI_TOKEN=
COMMUNICATION_AI_MODEL=

# Use the 32-character Account ID shown in the Cloudflare R2 dashboard.
R2_ACCOUNT_ID=replace_me
# Recommended: copy the exact S3 API endpoint shown in Cloudflare. EU buckets
# include `.eu` in this hostname. Leave empty to derive it from the two values
# around this line.
R2_ENDPOINT=
# Required for jurisdiction-restricted buckets. Use `eu` for an EU bucket,
# `fedramp` for FedRAMP, or leave empty for the standard automatic location.
R2_JURISDICTION=
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=replace_me
# Public delivery/custom-domain URL for this bucket; this is not the S3 API
# endpoint and must not contain credentials.
R2_PUBLIC_URL=https://example.invalid

